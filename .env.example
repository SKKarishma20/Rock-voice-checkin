# ROCK Check-in / Vet Front Desk — copy to .env and fill in your values.
# cascade | realtime
ENGINE_PROFILE=cascade

OPENAI_API_KEY=sk-...
# Optional: leave empty to route STT/TTS via LiveKit Inference
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

REALTIME_MODEL=gpt-realtime-mini
LLM_MODEL=gpt-4.1-mini
CARTESIA_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
REALTIME_VOICE=marin

# --- Turn detection tuning ---
EOT_MIN_DELAY=0.5
EOT_MAX_DELAY=1.5
EOT_UNLIKELY_THRESHOLD=0
FALSE_INTERRUPTION_TIMEOUT=1.0

# --- LiveKit ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxx
LIVEKIT_API_SECRET=xxxxxxxx

# Distinct dispatch name for this worker
AGENT_NAME=checkin-agent

# --- Twilio voice number + LiveKit outbound SIP trunk ---
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxx

# --- Vet warm-transfer escalation ---
VET_ESCALATION_NUMBER=+1XXXXXXXXXX
HOLD_MUSIC_FILE=hold_music.mp3

DEBUG_TRANSCRIPTS=false
